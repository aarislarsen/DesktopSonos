<Window x:Class="DesktopSonos.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Share credentials"
        Height="220" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        TextElement.Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,14" />

        <TextBlock Text="USER NAME" Style="{StaticResource SectionLabel}" />
        <TextBox x:Name="UserBox" IsReadOnly="True" Margin="0,0,0,10" />

        <TextBlock Text="PASSWORD" Style="{StaticResource SectionLabel}" />
        <Border Background="{StaticResource RaisedBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                CornerRadius="6" Margin="0,0,0,16">
            <PasswordBox x:Name="PasswordEntry" Padding="9,6" BorderThickness="0"
                         Background="Transparent" Foreground="{StaticResource TextBrush}"
                         CaretBrush="{StaticResource AccentBrush}" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Connect" IsDefault="True" Style="{StaticResource AccentButton}"
                    Click="Connect_Click" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
