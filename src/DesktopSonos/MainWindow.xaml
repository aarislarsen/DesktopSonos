<Window x:Class="DesktopSonos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:DesktopSonos.Converters"
        xmlns:vm="clr-namespace:DesktopSonos.ViewModels"
        xmlns:ui="clr-namespace:DesktopSonos.UI"
        Title="DesktopSonos"
        Height="900" Width="1480" MinHeight="640" MinWidth="1080"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True"
        Background="{StaticResource WindowBackground}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <!-- WindowChrome overhangs the screen edges when maximized; the margin pulls it back. -->
    <Border x:Name="RootShell" Background="{StaticResource WindowBackground}"
            TextElement.Foreground="{StaticResource TextBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

      <Grid>

        <!-- The full window and the compact strip are two layouts of the same window, so the
             player, the queue and every subscription carry on across a switch. -->
        <Grid x:Name="FullView"
              Visibility="{Binding IsCompactView, Converter={StaticResource InverseBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- ==================== title bar ==================== -->
            <Grid Grid.Row="0" Background="{StaticResource WindowBackground}">
                <TextBlock x:Name="Wordmark" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="11.5">
                    <Run Text="DESKTOP" Foreground="{StaticResource FaintTextBrush}" />
                    <Run Text="SONOS" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                </TextBlock>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,7,6,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="▭" Style="{StaticResource WindowButton}"
                            Command="{Binding ToggleCompactViewCommand}"
                            ToolTip="Compact player  (Ctrl+M)" />
                    <Button Content="—" Style="{StaticResource WindowButton}" Click="Minimize_Click"
                            ToolTip="Minimise to the notification area" />
                    <Button Content="▢" Style="{StaticResource WindowButton}" Click="MaximizeRestore_Click"
                            ToolTip="Maximise / restore" />
                    <Button Content="✕" Style="{StaticResource CloseButton}" Click="Close_Click"
                            ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- ==================== content ==================== -->
            <Grid Grid.Row="1" Margin="14,2,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RoomsColumn" Width="268" MinWidth="46" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="330" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition x:Name="LibraryColumn" Width="404" MinWidth="46" />
                </Grid.ColumnDefinitions>

                <!-- rooms rail: expands and collapses sideways -->
                <Grid Grid.Column="0">

                    <Border Visibility="{Binding IsRoomsExpanded, Converter={StaticResource InverseBoolToVis}}"
                            Background="{StaticResource PanelBackground}" CornerRadius="8">
                        <Button Command="{Binding ToggleRoomsCommand}" BorderThickness="0"
                                Background="Transparent" Padding="0" Margin="0"
                                VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                                ToolTip="Show the room list">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="▸" Style="{StaticResource SectionLabel}"
                                           HorizontalAlignment="Center" Margin="0,0,0,14" />
                                <TextBlock Text="ROOMS" Style="{StaticResource SectionLabel}"
                                           HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="90" />
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding RoomLabel}" Style="{StaticResource Faint}"
                                           HorizontalAlignment="Center">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="90" />
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Border>

                    <DockPanel Visibility="{Binding IsRoomsExpanded, Converter={StaticResource BoolToVis}}">

                        <!-- Square logo area. Drop artwork at Assets\logo.png; it tracks the rail width.
                             No fill or border of its own: artwork with a transparent background sits
                             directly on the panel colour. -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,16"
                                Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                                MaxHeight="300"
                                Background="Transparent" BorderThickness="0">
                            <Grid>
                                <Image x:Name="LogoImage" Stretch="Uniform" Margin="6"
                                       Visibility="Collapsed"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <StackPanel x:Name="LogoFallback" VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <Canvas Width="72" Height="72" HorizontalAlignment="Center"
                                            Margin="0,0,0,14">
                                        <Ellipse Width="72" Height="72" Stroke="{StaticResource AccentBrush}"
                                                 StrokeThickness="1.6" Opacity="0.35" />
                                        <Ellipse Canvas.Left="13" Canvas.Top="13" Width="46" Height="46"
                                                 Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                                                 Opacity="0.65" />
                                        <Ellipse Canvas.Left="26" Canvas.Top="26" Width="20" Height="20"
                                                 Fill="{StaticResource AccentBrush}" />
                                    </Canvas>
                                    <TextBlock Text="DesktopSonos" FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Assets\logo.png" Style="{StaticResource Faint}"
                                               HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                            <Button DockPanel.Dock="Left" Command="{Binding ToggleRoomsCommand}"
                                    BorderThickness="0" Background="Transparent"
                                    Padding="4,2" Margin="0,0,0,6" HorizontalContentAlignment="Left"
                                    ToolTip="Collapse the room list to the side">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▾" Style="{StaticResource SectionLabel}" Margin="0,0,7,0" />
                                    <TextBlock Text="ROOMS" Style="{StaticResource SectionLabel}" Margin="0" />
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Content="find" HorizontalAlignment="Right"
                                    Padding="8,2" Margin="0,0,0,6" FontSize="10.5"
                                    Command="{Binding DiscoverCommand}"
                                    ToolTip="Search the network again. Normally unnecessary — rooms are remembered." />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="Group" Command="{Binding GroupCheckedCommand}" Margin="3,0"
                                    ToolTip="Join the ticked rooms to the selected room" />
                            <Button Content="Ungroup" Command="{Binding UngroupCheckedCommand}" Margin="3,0" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Rooms}"
                                 SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,5" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Chrome" CornerRadius="8" Padding="10,9"
                                                        Background="{StaticResource PanelBackground}"
                                                        BorderThickness="1" BorderBrush="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background"
                                                                Value="{StaticResource HoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Chrome" Property="BorderBrush"
                                                                Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="Chrome" Property="Background"
                                                                Value="{StaticResource RaisedBackground}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SpeakerViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Margin="0,0,9,0" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  ToolTip="Tick to include in the next Group action" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding RoomName}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding GroupDescription}"
                                                       Style="{StaticResource Faint}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                   Style="{StaticResource Faint}" Text="{Binding Volume}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              IsEnabled="{Binding IsRoomsExpanded}" />

                <!-- centre: queue, with this PC's audio underneath it -->
                <DockPanel Grid.Column="2">

                    <!-- Streaming source lives with the queue: both answer "what comes out of the speaker". -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Border Height="1" Background="{StaticResource PanelBorder}" Margin="0,0,0,10" />
                        <DockPanel Margin="0,0,0,6" LastChildFill="False">
                            <TextBlock Text="STREAM THIS PC" Style="{StaticResource SectionLabel}" />
                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="8,0,2,8"
                                       Foreground="{StaticResource AccentBrush}" FontSize="11.5"
                                       MaxWidth="260" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding IsDesktopStreaming, Converter={StaticResource BoolToVis}}">
                                <Run Text="live · " />
                                <Run Text="{Binding CaptureLevelText, Mode=OneWay}" />
                                <Run Text=" · the queue is on hold" />
                            </TextBlock>
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="70"
                                    Command="{Binding ToggleDesktopStreamCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                        <Setter Property="Content" Value="Start" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDesktopStreaming}" Value="True">
                                                <Setter Property="Content" Value="Stop" />
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                <Setter Property="Background" Value="Transparent" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button DockPanel.Dock="Right" Content="↻" Padding="9,5" Margin="6,0,0,0"
                                    Command="{Binding RefreshAudioSourcesCommand}"
                                    ToolTip="Re-scan open windows" />
                            <ComboBox ItemsSource="{Binding AudioSources}"
                                      SelectedItem="{Binding SelectedAudioSource, Mode=TwoWay}"
                                      DisplayMemberPath="Display"
                                      ToolTip="A whole output device, or one application window. ♪ marks apps making sound now." />
                        </DockPanel>

                        <DockPanel Margin="0,8,0,0" IsEnabled="{Binding CanRouteApp}">
                            <TextBlock DockPanel.Dock="Left" Text="Send app to" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox ItemsSource="{Binding RouteTargets}"
                                      SelectedItem="{Binding SelectedRouteTarget, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      ToolTip="Move the chosen app to another output while streaming, so it plays on Sonos and not here. Pick an output nothing is plugged into. Put back automatically when streaming stops." />
                        </DockPanel>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Gain" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock DockPanel.Dock="Right" Width="52" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource Caption}"
                                       Text="{Binding StreamGainText, Mode=OneWay}" />
                            <Slider Minimum="0" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding StreamGainDb, Mode=TwoWay}"
                                    ToolTip="Loopback follows the Windows volume of the captured device. Raise this if the level reads too low." />
                        </DockPanel>
                    </StackPanel>

                    <!-- Faded while streaming: the queue is not what you are hearing. -->
                    <DockPanel>
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDesktopStreaming}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0.3" Duration="0:0:0.25" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1.0" Duration="0:0:0.25" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                            <TextBlock Text="QUEUE" Style="{StaticResource SectionLabel}" />
                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,2,8"
                                       Style="{StaticResource Faint}" Text="{Binding QueueCountText}" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="⤮  Shuffle" Style="{StaticResource AccentButton}"
                                    Command="{Binding ShuffleQueueCommand}"
                                    ToolTip="Reorder the queue at random. Undoable with Ctrl+Z." />
                            <Button Content="↑" Padding="10,6" Command="{Binding MoveQueueItemUpCommand}" />
                            <Button Content="↓" Padding="10,6" Command="{Binding MoveQueueItemDownCommand}" />
                            <Button Content="Remove" Command="{Binding RemoveFromQueueCommand}"
                                    ToolTip="Remove the selected entry  (Delete)" />
                            <Button Content="Clear" Command="{Binding ClearQueueCommand}" />
                            <Button Content="Refresh" Command="{Binding RefreshQueueCommand}" Margin="0" />
                        </StackPanel>

                        <ListView x:Name="QueueList" ItemsSource="{Binding Queue}"
                                  SelectedItem="{Binding SelectedQueueItem, Mode=TwoWay}"
                                  MouseDoubleClick="QueueList_MouseDoubleClick"
                                  ToolTip="Double-click an entry to jump to it">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="#" Width="36" DisplayMemberBinding="{Binding Position}" />
                                    <GridViewColumn Header="TITLE" Width="240" DisplayMemberBinding="{Binding Title}" />
                                    <GridViewColumn Header="ARTIST" Width="150" DisplayMemberBinding="{Binding Artist}" />
                                    <GridViewColumn Header="TIME" Width="56" DisplayMemberBinding="{Binding DurationText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </DockPanel>

                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              IsEnabled="{Binding IsLibraryExpanded}" />

                <!-- side: library, collapses sideways like the rooms rail -->
                <Grid Grid.Column="4">

                    <Border Visibility="{Binding IsLibraryExpanded, Converter={StaticResource InverseBoolToVis}}"
                            Background="{StaticResource PanelBackground}" CornerRadius="8">
                        <Button Command="{Binding ToggleLibraryCommand}" BorderThickness="0"
                                Background="Transparent" Padding="0" Margin="0"
                                VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                                ToolTip="Show the music library">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="◂" Style="{StaticResource SectionLabel}"
                                           HorizontalAlignment="Center" Margin="0,0,0,14" />
                                <TextBlock Text="LIBRARY" Style="{StaticResource SectionLabel}"
                                           HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="90" />
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding TrackCountText}" Style="{StaticResource Faint}"
                                           HorizontalAlignment="Center">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="90" />
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Border>

                    <DockPanel Visibility="{Binding IsLibraryExpanded, Converter={StaticResource BoolToVis}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                            <Button DockPanel.Dock="Left" Command="{Binding ToggleLibraryCommand}"
                                    BorderThickness="0" Background="Transparent"
                                    Padding="4,2" Margin="0,0,0,6" HorizontalContentAlignment="Left"
                                    ToolTip="Collapse the library to the side">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▸" Style="{StaticResource SectionLabel}" Margin="0,0,7,0" />
                                    <TextBlock Text="LIBRARY" Style="{StaticResource SectionLabel}" Margin="0" />
                                </StackPanel>
                            </Button>
                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       Style="{StaticResource Faint}" Margin="8,0,2,8"
                                       MaxWidth="250" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding TrackCountText, Mode=OneWay}" />
                                <Run Text=" " />
                                <Run Text="{Binding LibraryStatus, Mode=OneWay}"
                                     Foreground="{StaticResource AccentBrush}" />
                                <Run Text=" " />
                                <Run Text="{Binding SelectionSummary, Mode=OneWay}"
                                     Foreground="{StaticResource AccentBrush}" />
                            </TextBlock>
                        </DockPanel>

                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBox x:Name="SearchBox" FontSize="13.5" Padding="12,8"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                            <!-- 13 = the box's 1 px border plus its 12 px left padding, so the
                                 placeholder starts exactly where the caret sits rather than a
                                 character to the right of it. -->
                            <TextBlock IsHitTestVisible="False" Margin="13,0,0,0" VerticalAlignment="Center"
                                       FontSize="13.5" Foreground="{StaticResource FaintTextBrush}"
                                       Text="Search — just start typing">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilterText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- CenteredWrapPanel, not WrapPanel: a plain wrap panel left-aligns the
                             second line, which is what put the last few buttons off to one side. -->
                        <ui:CenteredWrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button Content="Play next" Style="{StaticResource AccentButton}"
                                    Margin="3,0,3,6" Command="{Binding PlayNextCommand}"
                                    ToolTip="Insert after the current track  (double-click, or Enter)" />
                            <Button Content="Add to queue" Margin="3,0,3,6"
                                    Command="{Binding AddToQueueCommand}"
                                    ToolTip="Append to the end of the queue" />
                            <Button Content="Play now" Margin="3,0,3,6" Command="{Binding PlayNowCommand}"
                                    ToolTip="Replace the whole queue with the selection and play" />
                            <Button Content="Queue all" Margin="3,0,3,6" Command="{Binding PlayAllCommand}"
                                    ToolTip="Replace the queue with every track listed" />
                            <Button Content="Shuffle in" Margin="3,0,3,6" Command="{Binding ShuffleLibraryCommand}"
                                    ToolTip="Fill the queue with random tracks from the library, up to the 500-entry Sonos limit" />
                            <Button Content="Add folder…" Margin="3,0,3,6" Command="{Binding AddFolderCommand}" />
                            <Button Content="Rescan" Margin="3,0,3,6" Command="{Binding RefreshLibraryCommand}"
                                    ToolTip="Re-read the remembered folders now" />
                            <!-- Padding, not a fixed width: 32 px minus the button's own 12 px sides
                                 left 8 px for a 13 px glyph, so the gear was clipped. -->
                            <Button Content="⚙" Padding="9,6" Margin="3,0,3,6"
                                    Command="{Binding ToggleSettingsCommand}" ToolTip="Network share and log" />
                        </ui:CenteredWrapPanel>

                        <ListView x:Name="TrackList" ItemsSource="{Binding Tracks}"
                                  SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                                  SelectionMode="Extended"
                                  SelectionChanged="TrackList_SelectionChanged"
                                  MouseDoubleClick="TrackList_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="TITLE" Width="132" DisplayMemberBinding="{Binding Title}" />
                                    <GridViewColumn Header="ARTIST" Width="92" DisplayMemberBinding="{Binding DisplayArtist}" />
                                    <GridViewColumn Header="ALBUM" Width="92" DisplayMemberBinding="{Binding DisplayAlbum}" />
                                    <GridViewColumn Header="TIME" Width="44" DisplayMemberBinding="{Binding DurationText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Grid>
            </Grid>

            <!-- ==================== transport ==================== -->
            <Border Grid.Row="2" Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The play button is deliberately the largest target in the window. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,26,0">
                        <Button Content="{Binding PlayGlyph}" Style="{StaticResource PlayButton}"
                                Command="{Binding PlayPauseCommand}" ToolTip="Play / pause  (Space)" />
                        <!-- Drawn rather than typed: the ⏮ ⏹ ⏭ characters fall back to a symbol
                             font whose glyph boxes are wider than the ink, which leaves them
                             visibly off-centre inside a round button. Paths are centred exactly.
                             Fill follows the button's Foreground so the hover trigger still works. -->
                        <Button Style="{StaticResource OutlineIconButton}"
                                Command="{Binding PreviousCommand}" ToolTip="Previous track">
                            <Path Data="M 0,0 L 2.4,0 L 2.4,10 L 0,10 Z M 10,0 L 10,10 L 3.2,5 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource OutlineIconButton}"
                                Command="{Binding StopPlaybackCommand}" ToolTip="Stop">
                            <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource OutlineIconButton}"
                                Command="{Binding NextCommand}" ToolTip="Next track">
                            <Path Data="M 0,0 L 6.8,5 L 0,10 Z M 7.6,0 L 10,0 L 10,10 L 7.6,10 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,2">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Faint}"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding PositionText, Mode=OneWay}" />
                                <Run Text="/" />
                                <Run Text="{Binding DurationText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding NowPlaying}" FontSize="14"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <Slider x:Name="PositionSlider" Grid.Row="1"
                                Minimum="0" Maximum="{Binding DurationSeconds}"
                                Value="{Binding PositionSeconds, Mode=OneWay}"
                                PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="30,0,0,0">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding RoomLabel}" FontSize="12.5" TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis" MaxWidth="180" />
                            <TextBlock Style="{StaticResource Faint}" TextAlignment="Right"
                                       Text="{Binding TransportState}" />
                        </StackPanel>
                        <TextBlock Text="🔊" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <Slider Width="150" VerticalAlignment="Center" Minimum="0" Maximum="100"
                                Value="{Binding SelectedRoom.Volume, Mode=TwoWay}"
                                ToolTip="Room volume  (Ctrl+↑ / Ctrl+↓)" />
                        <TextBlock Width="34" TextAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource Caption}"
                                   Text="{Binding SelectedRoom.Volume, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== status ==================== -->
            <Grid Grid.Row="3" Margin="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Status}" VerticalAlignment="Center"
                           Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Faint}" Text="{Binding UndoDescription}"
                               Margin="0,0,12,0" />
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource FaintTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveEventing}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource Faint}" Text="live" />
                </StackPanel>
            </Grid>

            <!-- ==================== settings drawer ==================== -->
            <Border Grid.Row="1" Grid.RowSpan="2" Background="#CC0E1013"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                <Border Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                        CornerRadius="10" Padding="22" MaxHeight="540" Margin="0,20">
                    <!-- Scrolls rather than clipping: at the window's minimum height, and at 125%
                         display scaling, the log alone is taller than the space left over. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="Network share and diagnostics" FontSize="15" />
                            <!-- Padding, not a fixed width: 30 px minus the button's own 12 px
                                 sides left 6 px for an 11 px glyph, so the ✕ was clipped. -->
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="✕"
                                    Padding="9,5" Margin="0" Command="{Binding ToggleSettingsCommand}" />
                        </DockPanel>

                        <TextBlock Text="NAS PATH" Style="{StaticResource SectionLabel}" />
                        <TextBox Text="{Binding NetworkPath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8" />
                        <TextBlock Text="USER NAME (leave blank to use your Windows login)"
                                   Style="{StaticResource SectionLabel}" />
                        <TextBox Text="{Binding ShareUser, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Add share" Style="{StaticResource AccentButton}"
                                    Command="{Binding AddNetworkPathCommand}" />
                            <Button Content="Forget library" Command="{Binding ForgetLibraryCommand}" />
                            <TextBox Width="120" Margin="6,0,0,0"
                                     Text="{Binding ManualIp, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Add a speaker by IP if discovery cannot see it" />
                            <Button Content="Add by IP" Command="{Binding AddByIpCommand}" Margin="6,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="ACTIVITY" Style="{StaticResource SectionLabel}" />
                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="180"
                                 FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>
        </Grid>

        <!-- ==================== compact player ====================
             One strip: what is playing, the transport, the position, the volume, and five rows of
             the queue. Sized to sit along the top or bottom of a screen all day. -->
        <Border x:Name="CompactBar" Background="{StaticResource PanelBackground}"
                Visibility="{Binding IsCompactView, Converter={StaticResource BoolToVis}}">
            <Grid Margin="12,7,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0 sits inside the chrome caption area, so dragging it moves the window. -->
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="⤢" Style="{StaticResource WindowButton}"
                                Command="{Binding ToggleCompactViewCommand}"
                                ToolTip="Back to the full window  (Ctrl+M)" />
                        <Button Content="—" Style="{StaticResource WindowButton}" Click="Minimize_Click"
                                ToolTip="Minimise to the notification area" />
                        <Button Content="✕" Style="{StaticResource CloseButton}" Click="Close_Click"
                                ToolTip="Close" />
                    </StackPanel>

                    <Ellipse DockPanel.Dock="Left" Width="7" Height="7" VerticalAlignment="Center"
                             Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource FaintTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveEventing}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding NowPlaying}" FontSize="12.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding NowPlaying}" />
                </DockPanel>

                <!-- Rows 1 and 2 fall inside the chrome's caption band, so they have to opt out
                     of it or the buttons and sliders would only drag the window. -->
                <Grid Grid.Row="1" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="60" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding PlayGlyph}" Style="{StaticResource IconButton}"
                                Width="32" Height="30" FontSize="14"
                                Command="{Binding PlayPauseCommand}" ToolTip="Play / pause  (Space)" />
                        <Button Content="⏮" Style="{StaticResource IconButton}"
                                Width="32" Height="30" FontSize="12"
                                Command="{Binding PreviousCommand}" ToolTip="Previous track" />
                        <Button Content="⏭" Style="{StaticResource IconButton}"
                                Width="32" Height="30" FontSize="12"
                                Command="{Binding NextCommand}" ToolTip="Next track" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0"
                               Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis"
                               Text="{Binding RoomLabel}" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔊" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <Slider Width="96" VerticalAlignment="Center" Minimum="0" Maximum="100"
                                Value="{Binding SelectedRoom.Volume, Mode=TwoWay}"
                                ToolTip="Room volume  (Ctrl+↑ / Ctrl+↓)" />
                    </StackPanel>
                </Grid>

                <!-- Row 2: the same seek bar as the full window, with the clock beside it. -->
                <DockPanel Grid.Row="2" Margin="0,4,0,0"
                           shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Faint}"
                               VerticalAlignment="Center" Margin="8,0,0,0">
                        <Run Text="{Binding PositionText, Mode=OneWay}" />
                        <Run Text="/" />
                        <Run Text="{Binding DurationText, Mode=OneWay}" />
                    </TextBlock>

                    <Slider x:Name="CompactPositionSlider"
                            Minimum="0" Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds, Mode=OneWay}"
                            PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="CompactPositionSlider_PreviewMouseLeftButtonUp" />
                </DockPanel>

                <!-- Row 3: the queue, five rows of it. Rows are a fixed 19 px so the strip's height
                     is exactly five of them; the rest of the queue is a scroll away. -->
                <ListBox Grid.Row="3" x:Name="CompactQueueList" Margin="0,6,0,0" Height="95"
                         ItemsSource="{Binding Queue}"
                         SelectedItem="{Binding SelectedQueueItem, Mode=TwoWay}"
                         MouseDoubleClick="CompactQueueList_MouseDoubleClick"
                         shell:WindowChrome.IsHitTestVisibleInChrome="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ToolTip="Double-click an entry to jump to it">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="FontSize" Value="11.5" />
                            <Setter Property="Height" Value="19" />
                            <Setter Property="Padding" Value="6,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentDimBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Position}" MinWidth="22"
                                           Foreground="{StaticResource FaintTextBrush}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}"
                                           Margin="8,0,0,0" Foreground="{StaticResource FaintTextBrush}" />
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Title}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
      </Grid>
    </Border>
</Window>
