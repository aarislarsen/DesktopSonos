<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DesktopSonos</RootNamespace>
    <AssemblyName>DesktopSonos</AssemblyName>
    <!-- LAME ships x86/x64 natives; force 64-bit so the right one is picked. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Generated from Assets\logo.png; carries 16-256 px frames so Explorer, the taskbar and the
         tray all get a sharp version. -->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Drop Logo.png here to brand the app; the folder may be empty. -->
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

</Project>
